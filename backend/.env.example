# Copy to .env and fill in. LLM_PROVIDER=mock runs everything offline (no key needed).
LLM_PROVIDER=mock

# anthropic:  ANTHROPIC_API_KEY=...
# gemini:     GEMINI_API_KEY=...
# openai-compatible (Groq etc.):  LLM_API_KEY=...  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=<model name>
# LLM_MODEL=            # optional override of the default model for anthropic / gemini

ORCH_DB=orchestrator.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
