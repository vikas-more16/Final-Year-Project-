PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/orchestra
CLIENT_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email (optional in development: without it, invite links are logged to the console)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Orchestra <you@gmail.com>"

# AI agents: any OpenAI-compatible provider
# Groq (free tier): https://api.groq.com/openai/v1   OpenRouter: https://openrouter.ai/api/v1   Ollama (local): http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_PLANNER=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
# Tokens-per-minute budget per model (Groq free tier: 8000; set 0 to disable pacing, e.g. for Ollama)
LLM_TPM_LIMIT=8000
