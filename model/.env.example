# Copy to .env and fill in. LLM_PROVIDER=mock runs everything offline (no key needed).
LLM_PROVIDER=openai
LLM_API_KEY=grok_api_ket_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_MIN_INTERVAL=0
LLM_MAX_RETRIES=3
LLM_REASONING_EFFORT=low

ORCH_DB=orchestrator.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173